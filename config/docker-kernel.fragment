# ============================================================
# 红米 K40 (alioth) Docker 能力配置片段
# 用途：合并进 alioth_defconfig，补上当前原厂内核缺失的容器能力
# 依据：2026-10-08 对手机运行内核的完整配置实测（6499 行）
# ============================================================

# —— 致命项：缺任何一个，docker run 直接失败 ——
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_CGROUP_DEVICE=y

# —— 重要项：不补会踩坑 ——
CONFIG_USER_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_IPC_NS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# —— 确认已具备（原厂已开启，此处显式声明防止被上游变更改掉）——
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_NETFILTER=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_FUSE_FS=y
CONFIG_AIO=y
