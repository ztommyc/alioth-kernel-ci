# ============================================================
# 红米 K40 (alioth) Docker 能力配置片段
# 用途：合并进 alioth_defconfig，补上当前原厂内核缺失的容器能力
# 依据：2026-10-08 对手机运行内核的完整配置实测（6499 行）
# ============================================================

# —— 致命项：缺任何一个，docker run 直接失败 ——
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_CGROUP_DEVICE=y

# —— 重要项：不补会踩坑 ——
CONFIG_USER_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_IPC_NS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# —— 确认已具备（原厂已开启，此处显式声明防止被上游变更改掉）——
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_NETFILTER=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_FUSE_FS=y
CONFIG_AIO=y

# ============================================================
# 与「能否正常启动 / 能否带动原厂 vendor 模块」直接相关的修正
# 依据：2026-10-08 原厂内核配置 vs 自编内核配置逐项比对
# ============================================================

# —— 模块签名 ——
# alioth_defconfig 自带 MODULE_SIG + MODULE_SIG_FORCE=y，而原厂内核
# 是 "# CONFIG_MODULE_SIG is not set"。开着 FORCE 会导致：
#   ① vendor_boot 里原厂签名的模块（显示/UFS/音频/WiFi）全部拒载；
#   ② 本仓库 scripts/patch-module-compat.py 对 vermagic 的修补完全失效
#      （签名校验发生在 check_modinfo 之前，先失败就退出）。
# 因此这里显式关闭，与原厂行为对齐。
# CONFIG_MODULE_SIG is not set

# —— 启动诊断 ——
# 原厂为 =y，alioth_defconfig 未包含。没有串口控制台时，
# 内核早期崩溃不会在 pstore/ramoops 里留下任何日志。
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# —— 触屏（原厂为 =y，alioth_defconfig 缺失，不补会导致触屏失效）——
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_I2C=y
